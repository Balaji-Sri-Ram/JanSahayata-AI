PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/grievance_platform
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8000
NODE_ENV=development

# LLM API Keys (Gemini API or OpenRouter API)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# LLM Provider priority: 'gemini' | 'openrouter' | 'auto'
LLM_PROVIDER=auto

# Authentication & Security
JWT_SECRET=your_secure_jwt_secret_here
SUPER_ADMIN_EMAIL=admin@jansahayata.gov.in
SUPER_ADMIN_PASSWORD=Admin@JanSahayata2026!

# Official Government Email & OTP Dispatch (Gmail SMTP)
# Custom Government Display Name: "Government of India • JanSahayata (CPGRAMS)"
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# SMS & WhatsApp OTP Delivery (Optional - If unset, built-in developer console simulator is used)
# Twilio SMS & WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Meta WhatsApp Cloud API (Alternative)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=


